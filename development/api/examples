curl -k -X POST \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
    "query": "agent.id:'"$AGENT_ID"'",
    "from": "now-24h",
    "to": "now",
    "filters": {}
  }' \
  "$WAZUH_API/alerts/search" | jq
```

